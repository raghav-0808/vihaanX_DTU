# Supabase project settings
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only keys. Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
LOVABLE_API_KEY=your-lovable-ai-gateway-key

# Optional local AI provider. When set, Ollama is used instead of Lovable AI.
# For a deployed server, this URL must be reachable from the server runtime.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# Optional; needed only to generate/apply Drizzle migrations.
LOVABLE_DB_MIGRATION_URL=your-postgres-migration-connection-string
